{
  "version": 2,
  "regions": ["sin1"],
  "fluid": true,
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
