# Browser build configuration. Keep hosted API traffic on the frontend origin.
# Vite development still uses its existing localhost backend proxy.
VITE_API_BASE_URL=/api/v1

# SERVER ONLY: set in Vercel for the corresponding environment.
# Never prefix this setting, an OIDC token, or a bypass token with VITE_.
# Preview on the codex/analyst-workspace-rebuild branch:
# DATALYZE_API_ORIGIN=https://datalyze-git-codex-analyst-works-fdfde5-revanthjoshuas-projects.vercel.app
# Production, only when the rebuilt backend is deployed there:
# DATALYZE_API_ORIGIN=https://datalyze-gray.vercel.app
