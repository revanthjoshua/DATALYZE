{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["sin1"],
  "fluid": true,
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,storage/**,venv/**,.venv/**,__pycache__/**,**/__pycache__/**,.env*,*.db,*.sqlite*,*.log}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/cron",
      "schedule": "17 3 * * *"
    }
  ]
}
