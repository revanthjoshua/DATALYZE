# ==============================================================================
# Datalyze Backend Environment Configuration
# ==============================================================================

# Runtime Environment: development | production | test
ENVIRONMENT=development

# Application Security (generate with `openssl rand -hex 32` for production)
SECRET_KEY=datalyze-dev-key-change-in-production-2026-decision-intel
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: Neon PostgreSQL / standard PostgreSQL in production, SQLite in local dev
DATABASE_URL=postgresql+psycopg2://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins: comma-separated list or JSON array of trusted frontend URLs
CORS_ORIGINS=http://localhost:5173,https://your-datalyze-frontend.vercel.app

# Frontend URL (for transactional email links: invite acceptance & password reset)
FRONTEND_URL=http://localhost:5173

# Resend Transactional Email API (https://resend.com)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=Datalyze <onboarding@resend.dev>

# Persistent Dataset Storage: auto | local | db | s3
STORAGE_BACKEND=auto
MAX_UPLOAD_SIZE_BYTES=52428800

# Optional S3 / Cloudflare R2 credentials (if using external object storage)
# S3_BUCKET_NAME=your-bucket-name
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=auto
