# ==============================================================================
# Datalyze Backend Environment Configuration
# ==============================================================================

# Runtime Environment: development | production | test
ENVIRONMENT=development

# Application Security (generate with `openssl rand -hex 32` for production)
SECRET_KEY=datalyze-dev-key-change-in-production-2026-decision-intel
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local database. For production PostgreSQL, follow ../docs/DEPLOYMENT.md.
DATABASE_URL=sqlite:///./datalyze-local.db

# CORS Allowed Origins: comma-separated list or JSON array of trusted frontend URLs
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend URL (for transactional email links: invite acceptance & password reset)
FRONTEND_URL=http://localhost:5173

# Resend Transactional Email API (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Datalyze <onboarding@resend.dev>

# Persistent Dataset Storage: auto | local | db | s3
STORAGE_BACKEND=db
MAX_UPLOAD_SIZE_BYTES=52428800

# Operator-approved connectors and destinations start empty.
# Monitoring runs only when explicitly configured; see ../docs/AUTOMATION.md.
DATALYZE_SOURCES_JSON=[]
DATALYZE_NOTIFICATIONS_JSON=[]
DATALYZE_MONITOR_INTERVAL_SECONDS=0
# On Vercel, keep the permanent worker disabled. Daily cron is opt-in.
DATALYZE_SCHEDULER_MODE=manual
CRON_SECRET=
# Vercel automatically sets VERCEL=1 and caps files at 4,000,000 bytes,
# request bodies at 4,250,000 bytes and responses at 4,000,000 bytes.

# Optional S3 / Cloudflare R2 credentials (if using external object storage)
# S3_BUCKET_NAME=your-bucket-name
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=auto
